generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  phone        String    @unique @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  nickname     String?   @db.VarChar(50)
  avatar       String?   @db.VarChar(255)
  wechatOpenid String?   @map("wechat_openid") @db.VarChar(100)
  alipayUserId String?   @map("alipay_user_id") @db.VarChar(100)
  status       Int       @default(0) // 0:正常 1:封禁
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  merchant    Merchant?
  orders      Order[]
  reviews     Review[]
  favorites   Favorite[]
  userCoupons UserCoupon[]

  @@map("users")
}

// 商家表
model Merchant {
  id             BigInt   @id @default(autoincrement()) @db.BigInt
  userId         BigInt   @unique @map("user_id") @db.BigInt
  shopName       String   @map("shop_name") @db.VarChar(100)
  shopLogo       String?  @map("shop_logo") @db.VarChar(255)
  shopCover      String?  @map("shop_cover") @db.VarChar(255)
  contacts       String?  @db.VarChar(50)
  phone          String?  @db.VarChar(20)
  province       String?  @db.VarChar(50)
  city           String?  @db.VarChar(50)
  district       String?  @db.VarChar(50)
  address        String?  @db.VarChar(255)
  longitude      Decimal? @db.Decimal(10, 7)
  latitude       Decimal? @db.Decimal(10, 7)
  description    String?  @db.Text
  commissionRate Decimal  @default(5.00) @map("commission_rate") @db.Decimal(5, 2)
  authStatus     Int      @default(0) @map("auth_status") // 0:待审核 1:已认证 2:已拒绝
  status         Int      @default(0) // 0:正常 1:冻结 2:注销
  totalOrders    Int      @default(0) @map("total_orders")
  totalRevenue   Decimal  @default(0) @map("total_revenue") @db.Decimal(12, 2)
  rating         Decimal  @default(5.0) @db.Decimal(2, 1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user              User                    @relation(fields: [userId], references: [id])
  qualifications    MerchantQualification[]
  cars              Car[]
  fleetPackages     FleetPackage[]
  orders            Order[]
  reviews           Review[]
  withdrawalRecords WithdrawalRecord[]

  @@map("merchants")
}

// 商家资质表
model MerchantQualification {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  merchantId   BigInt   @map("merchant_id") @db.BigInt
  licenseImg   String?  @map("license_img") @db.VarChar(255)
  idCardImg    String?  @map("id_card_img") @db.VarChar(255)
  otherImgs    String?  @map("other_imgs") // JSON array
  status       Int      @default(0) // 0:待审核 1:通过 2:拒绝
  rejectReason String?  @map("reject_reason") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("merchant_qualifications")
}

// 车辆表
model Car {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  merchantId    BigInt   @map("merchant_id") @db.BigInt
  brand         String   @db.VarChar(50)
  model         String   @db.VarChar(100)
  year          Int
  color         String   @db.VarChar(20)
  seats         Int
  transmission  String   @db.VarChar(10) // 自动/手动
  fuelType      String   @map("fuel_type") @db.VarChar(10)
  description   String?  @db.Text
  images        String? // JSON array
  halfDayPrice  Decimal  @map("half_day_price") @db.Decimal(10, 2)
  fullDayPrice  Decimal  @map("full_day_price") @db.Decimal(10, 2)
  fleetPrice    Decimal? @map("fleet_price") @db.Decimal(10, 2)
  deposit       Decimal  @default(500) @db.Decimal(10, 2)
  decorationFee Decimal  @default(0) @map("decoration_fee") @db.Decimal(10, 2)
  status        Int      @default(0) // 0:上架 1:下架 2:待审核
  totalOrders   Int      @default(0) @map("total_orders")
  rating        Decimal  @default(5.0) @db.Decimal(2, 1)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  schedules     CarSchedule[]
  fleetPackages FleetPackage[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]

  @@map("cars")
}

// 车辆档期表
model CarSchedule {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  carId     BigInt   @map("car_id") @db.BigInt
  date      DateTime @db.Date
  status    Int      @default(0) // 0:可租 1:已租 2:维护中
  orderId   BigInt?  @map("order_id") @db.BigInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  car   Car    @relation(fields: [carId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([carId, date])
  @@map("car_schedules")
}

// 车队套餐表
model FleetPackage {
  id             BigInt   @id @default(autoincrement()) @db.BigInt
  merchantId     BigInt   @map("merchant_id") @db.BigInt
  name           String   @db.VarChar(100)
  mainCarId      BigInt   @map("main_car_id") @db.BigInt
  followCarModel String?  @map("follow_car_model") @db.VarChar(100)
  followCarCount Int      @default(3) @map("follow_car_count")
  halfDayPrice   Decimal  @map("half_day_price") @db.Decimal(10, 2)
  fullDayPrice   Decimal  @map("full_day_price") @db.Decimal(10, 2)
  description    String?  @db.Text
  isActive       Int      @default(1) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  mainCar  Car      @relation(fields: [mainCarId], references: [id])
  orders   Order[]

  @@map("fleet_packages")
}

// 订单表
model Order {
  id                 BigInt    @id @default(autoincrement()) @db.BigInt
  orderNo            String    @unique @map("order_no") @db.VarChar(50)
  userId             BigInt    @map("user_id") @db.BigInt
  merchantId         BigInt    @map("merchant_id") @db.BigInt
  carId              BigInt    @map("car_id") @db.BigInt
  fleetPackageId     BigInt?   @map("fleet_package_id") @db.BigInt
  followCarCount     Int?      @map("follow_car_count")
  serviceDate        DateTime  @map("service_date") @db.Date
  serviceType        String    @map("service_type") @db.VarChar(20) // half_day / full_day / fleet
  pickupTime         String    @map("pickup_time") @db.VarChar(10)
  pickupAddress      String    @map("pickup_address") @db.VarChar(255)
  ceremonyAddress    String    @map("ceremony_address") @db.VarChar(255)
  contactName        String    @map("contact_name") @db.VarChar(50)
  contactPhone       String    @map("contact_phone") @db.VarChar(20)
  remark             String?   @db.Text
  decorationRequired Int       @default(0) @map("decoration_required")
  totalAmount        Decimal   @map("total_amount") @db.Decimal(10, 2)
  depositAmount      Decimal   @map("deposit_amount") @db.Decimal(10, 2)
  balanceAmount      Decimal   @map("balance_amount") @db.Decimal(10, 2)
  commissionAmount   Decimal   @default(0) @map("commission_amount") @db.Decimal(10, 2)
  couponId           BigInt?   @map("coupon_id") @db.BigInt
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  payAmount          Decimal   @map("pay_amount") @db.Decimal(10, 2)
  status             String    @default("pending_pay") @db.VarChar(20) // pending_pay/pending_confirm/confirmed/in_progress/completed/cancelled/refunding/refunded
  paidAt             DateTime? @map("paid_at")
  completedAt        DateTime? @map("completed_at")
  cancelReason       String?   @map("cancel_reason") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id])
  merchant     Merchant        @relation(fields: [merchantId], references: [id])
  car          Car             @relation(fields: [carId], references: [id])
  fleetPackage FleetPackage?   @relation(fields: [fleetPackageId], references: [id])
  schedule     CarSchedule[]
  tracking     OrderTracking[]
  payments     Payment[]
  userCoupon   UserCoupon?
  review       Review?

  @@map("orders")
}

// 订单状态日志
model OrderTracking {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  orderId      BigInt   @map("order_id") @db.BigInt
  fromStatus   String?  @map("from_status") @db.VarChar(20)
  toStatus     String   @map("to_status") @db.VarChar(20)
  operatorType String   @map("operator_type") @db.VarChar(20) // user/merchant/admin/system
  operatorId   BigInt?  @map("operator_id") @db.BigInt
  remark       String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_tracking")
}

// 支付表
model Payment {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  orderId       BigInt    @map("order_id") @db.BigInt
  type          String    @db.VarChar(20) // deposit / balance / refund
  amount        Decimal   @db.Decimal(10, 2)
  paymentMethod String    @map("payment_method") @db.VarChar(20) // alipay / wechat
  tradeNo       String?   @map("trade_no") @db.VarChar(100)
  outTradeNo    String?   @map("out_trade_no") @db.VarChar(100)
  status        String    @default("pending") @db.VarChar(20) // pending / success / failed / refunded
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// 评价表
model Review {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  orderId           BigInt    @unique @map("order_id") @db.BigInt
  userId            BigInt    @map("user_id") @db.BigInt
  merchantId        BigInt    @map("merchant_id") @db.BigInt
  carId             BigInt    @map("car_id") @db.BigInt
  overallRating     Int       @map("overall_rating")
  carRating         Int?      @map("car_rating")
  punctualityRating Int?      @map("punctuality_rating")
  serviceRating     Int?      @map("service_rating")
  content           String?   @db.Text
  images            String? // JSON array
  replyContent      String?   @map("reply_content") @db.Text
  replyAt           DateTime? @map("reply_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])
  car      Car      @relation(fields: [carId], references: [id])

  @@map("reviews")
}

// 优惠券表
model Coupon {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(10) // fixed / percent
  value      Decimal  @db.Decimal(10, 2)
  minAmount  Decimal  @map("min_amount") @db.Decimal(10, 2)
  totalCount Int      @map("total_count")
  usedCount  Int      @default(0) @map("used_count")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  isActive   Int      @default(1) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userCoupons UserCoupon[]

  @@map("coupons")
}

// 用户优惠券
model UserCoupon {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  userId    BigInt    @map("user_id") @db.BigInt
  couponId  BigInt    @map("coupon_id") @db.BigInt
  usedAt    DateTime? @map("used_at")
  orderId   BigInt?   @unique @map("order_id") @db.BigInt
  createdAt DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@map("user_coupons")
}

// 收藏表
model Favorite {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  userId    BigInt   @map("user_id") @db.BigInt
  carId     BigInt   @map("car_id") @db.BigInt
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  car  Car  @relation(fields: [carId], references: [id])

  @@unique([userId, carId])
  @@map("favorites")
}

// Banner表
model Banner {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  title     String?  @db.VarChar(100)
  imageUrl  String   @map("image_url") @db.VarChar(255)
  linkUrl   String?  @map("link_url") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  status    Int      @default(0) // 0:启用 1:禁用
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

// 提现记录表
model WithdrawalRecord {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  merchantId  BigInt    @map("merchant_id") @db.BigInt
  amount      Decimal   @db.Decimal(10, 2)
  bankName    String    @map("bank_name") @db.VarChar(100)
  bankCardNo  String    @map("bank_card_no") @db.VarChar(50)
  accountName String    @map("account_name") @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(20) // pending / approved / rejected / completed
  auditRemark String?   @map("audit_remark") @db.VarChar(255)
  auditAt     DateTime? @map("audit_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("withdrawal_records")
}

// 管理员表
model Admin {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  realName     String?   @map("real_name") @db.VarChar(50)
  phone        String?   @db.VarChar(20)
  role         String    @default("operator") @db.VarChar(20) // super_admin / admin / operator
  status       Int       @default(0) // 0:正常 1:禁用
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}
